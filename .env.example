# Copy this file to .env and add your own API keys.
# Never upload or commit .env to GitHub.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional: configure a vision-capable Groq model for image understanding.
GROQ_VISION_MODEL=

# Optional: separate Gemini image-generation model. Leave blank until configured.
GEMINI_IMAGE_MODEL=

# Optional: enables local sentence-transformer semantic retrieval.
# First use downloads the configured model. Default is the lighter TF-IDF fallback.
ENABLE_SEMANTIC_EMBEDDINGS=false
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: change where the SQLite database is stored.
# DATABASE_PATH=/absolute/path/to/memory.db
